# LLM provider API keys for LangChain agents.
# DeepSeek is the primary active provider for this project.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Which provider the agents should use: deepseek | openai | anthropic | google
LLM_PROVIDER=deepseek

# DeepSeek defaults (OpenAI-compatible endpoint)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
